# Mock is the default: both forms are visible and submissions validate without delivery.
# Set to live only when real intake is intended and the receiver/policy below are configured.
ENQUIRY_MODE=mock
# HTTPS service accepting multipart/form-data and returning 2xx after durable receipt.
# Receives contact/project fields and optional files; configure retention and rate limiting there.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
# Canonical public origin for deployments behind a reverse proxy (no trailing slash).
SITE_URL=
# Approved, directly readable HTTPS privacy policy; required before enabling live delivery.
PRIVACY_POLICY_URL=
# Enable only after public-release QA and content approval, with HTTPS SITE_URL set.
SITE_INDEXING_ENABLED=false
